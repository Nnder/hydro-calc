BACKEND_URL=http://127.0.0.1:8000
VITE_BACKEND=http://127.0.0.1:8000
# Только сервер. Не помещать значения в public и не коммитить .env.
NUXT_SMTP_USER=
NUXT_SMTP_PASS=
# Постоянное закрытое хранилище в РФ, вне public/.output и каталога релизов.
NUXT_CONSENT_STORAGE_DIR=/var/lib/athydro/applications
# Подтверждённый рабочий ящик вместо прежнего Gmail для запасных частей.
NUXT_SPARE_PARTS_MAIL_TO=
